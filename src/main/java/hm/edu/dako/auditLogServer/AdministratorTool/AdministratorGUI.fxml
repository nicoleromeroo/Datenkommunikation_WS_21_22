<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox
xmlns="http://javafx.com/javafx"
xmlns:fx="http://javafx.com/fxml"
fx:controller="hm.edu.dako.auditLogServer.AdministratorTool.AdministratorGUI"
prefHeight="400.0" prefWidth="600.0">
maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="472.0" prefWidth="1027.0" spacing="10.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hm.dako.chat.admin_tool.AdminGUIController">
<padding>
    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
</padding>
<Label fx:id="headerLabel" text="Wähle ein AuditLog-File:" />
<HBox prefHeight="424.0" prefWidth="866.0">
    <children>
        <TreeView fx:id="stringTreeView" onMouseClicked="#event" prefHeight="300.0" prefWidth="203.0" />
        <AnchorPane prefHeight="396.0" prefWidth="659.0">
            <children>
                <Label layoutX="118.0" layoutY="46.0" text="# Clients:" />
                <Label layoutX="124.0" layoutY="84.0" text="# PDUs:" />
                <TextField fx:id="txtClientsCounter" editable="false" layoutX="181.0" layoutY="41.0" prefHeight="27.0" prefWidth="623.0" />
                <TextField fx:id="txtPDUCounter" editable="false" layoutX="181.0" layoutY="79.0" prefHeight="27.0" prefWidth="623.0" />
                <Label layoutX="122.0" layoutY="6.0" text="Log-File:" />
                <TextField fx:id="txtSelectedFile" editable="false" layoutX="181.0" layoutY="1.0" prefHeight="27.0" prefWidth="623.0" />
                <TableView fx:id="tableView" layoutX="19.0" layoutY="160.0" prefHeight="233.0" prefWidth="788.0">
                    <columns>
                        <TableColumn fx:id="clientC" prefWidth="98.0" text="Client" />
                        <TableColumn fx:id="PDUC" prefWidth="98.0" text="PDUs">
                            <columns>
                                <TableColumn fx:id="PDUUndefinedCounterC" minWidth="0.0" prefWidth="75.0" text="# Undefined" />
                                <TableColumn fx:id="PDULoginCounterC" minWidth="0.0" prefWidth="54.0" text="# Login" />
                                <TableColumn fx:id="PDULogoutCounterC" minWidth="0.0" prefWidth="59.0" text="# Logout" />
                                <TableColumn fx:id="PDUMessageCounterC" minWidth="0.0" prefWidth="74.0" text="# Messages" />
                                <TableColumn fx:id="PDUFinishCounterC" minWidth="0.0" prefWidth="53.0" text="# Finish" />
                            </columns>
                        </TableColumn>
                        <TableColumn fx:id="loginTimeC" prefWidth="130.0" text="Login" />
                        <TableColumn fx:id="logoutTimeC" prefWidth="125.0" text="Logout" />
                        <TableColumn fx:id="timeC" prefWidth="119.0" text="Zeit (HH:mm:ss)" />
                    </columns></TableView>
                <Label layoutX="26.0" layoutY="131.0" text="Informationen pro Client (Login und Logout liefert stets die Werte für die letzte aktive Session):" />
            </children></AnchorPane>
    </children>
</HBox>
<Button mnemonicParsing="false" onAction="#initAd">
    <graphic>
        <ImageView fitHeight="27.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/reload.png" />
            </image>
        </ImageView>
    </graphic>
</Button>
</VBox>